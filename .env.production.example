# Copy to ignored .env.production and inject real values securely.
# This example is not a deployment or provider approval.
APP_ENV=production
AUTH_PROVIDER=supabase
COOKIE_SECURE=true
APP_BASE_URL=https://your-app.example
PUBLIC_WEB_URL=https://your-app.example
DATABASE_ADMIN_URL=
DATABASE_URL=
SUPABASE_URL=
# Public anon key only. Never put a Supabase service_role key into the browser.
SUPABASE_ANON_KEY=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
# Required for encrypted provider token storage; unique Fernet key, not a password.
TOKEN_ENCRYPTION_KEY=
# Optional capabilities remain disconnected without credentials and approval.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_API_VERSION=
LINKEDIN_PUBLISHING_APPROVED=false
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
# Explicit current provider pricing; absence leaves generation unavailable.
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
LLM_MAX_OUTPUT_TOKENS=1500
PDL_API_KEY=
PDL_LICENSE_APPROVED=false
PDL_LICENSE_REFERENCE=
# Do not enable without an enforced network egress guard against private IPs.
RESEARCH_ALLOWED_DOMAINS=
RESEARCH_TERMS_APPROVED=false
RESEARCH_NETWORK_GUARD_APPROVED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_SEND_ENABLED=false
