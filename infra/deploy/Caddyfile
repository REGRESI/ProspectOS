# HTTPS with automatic Let's Encrypt certificates for $DOMAIN.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	# The web app proxies /api/* and /r/<code> (QR scans) to the API internally.
	reverse_proxy web:3000
	log {
		output stdout
		format json
	}
}
