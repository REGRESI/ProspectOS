# /opt/prospectos/server.env — chmod 600, never commit. setup-server.sh creates this file
# with fresh random secrets; fill in the empty values, then run setup-server.sh again.
DOMAIN=prospectos.example.de
ACME_EMAIL=
APP_BASE_URL=https://prospectos.example.de
# Generated by setup-server.sh:
POSTGRES_PASSWORD=
DB_APP_PASSWORD=
TOKEN_ENCRYPTION_KEY=
# Login in production goes through Supabase (EU project). Local demo login is disabled.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
# LinkedIn app: add https://<DOMAIN>/v1/integrations/linkedin/callback as redirect URL.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://prospectos.example.de/v1/integrations/linkedin/callback
LINKEDIN_API_VERSION=
LINKEDIN_PUBLISHING_APPROVED=false
# Backups: age public key (private key stays offline) and an rclone remote.
BACKUP_AGE_RECIPIENT=
BACKUP_REMOTE=storagebox:prospectos
BACKUP_KEEP_DAYS=30
