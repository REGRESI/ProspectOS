# Development only. Copy to .env; never commit credentials or lead data.
APP_ENV=development
DATABASE_ADMIN_URL=postgresql+psycopg://prospectos:prospectos_dev@127.0.0.1:5432/prospectos
DATABASE_URL=postgresql+psycopg://prospectos_app:prospectos_app_dev@127.0.0.1:5432/prospectos
POSTGRES_PASSWORD=prospectos_dev
DB_APP_PASSWORD=prospectos_app_dev
API_URL=http://127.0.0.1:8000
# Optional before the first seed: set your own local demo password.
# DEMO_PASSWORD=
# Set true only with HTTPS; local HTTP development needs false.
COOKIE_SECURE=false
APP_BASE_URL=http://localhost:3000
ASSET_ROOT=/tmp/prospectos-assets
# Optional real integrations, all off/unconnected unless configured and approved.
# Complete names and secure deployment guidance: .env.production.example.
# Production authentication: use a real HTTPS Supabase project and asymmetric JWT signing.
# Keep demo for local development; APP_ENV=production requires supabase and secure cookies.
AUTH_PROVIDER=demo
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
# Generate a Fernet key securely for encrypted LinkedIn token storage; never commit its value.
TOKEN_ENCRYPTION_KEY=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
# Operator must verify a currently supported version and granted Share on LinkedIn product/scopes.
LINKEDIN_API_VERSION=
LINKEDIN_PUBLISHING_APPROVED=false
# Real text generation; no model or prices are invented. Costs/budgets use USD cents.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
LLM_MAX_OUTPUT_TOKENS=1500
# Real image output only. Key/base fall back to LLM settings when empty.
# Set a verified maximum cost per image in USD cents before enabling.
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_BASE_URL=
IMAGE_MAX_COST_USD_CENTS=
# Licensed company search. License reference and operator/use-purpose review are mandatory.
PDL_API_KEY=
PDL_LICENSE_APPROVED=false
PDL_LICENSE_REFERENCE=
# OpenStreetMap discovery (ODbL). OSM_CONTACT identifies the operator per Nominatim policy.
OSM_DISCOVERY_ENABLED=false
OSM_CONTACT=
OSM_NOMINATIM_URL=
OSM_OVERPASS_URL=
# Website research requires explicit source review AND an independently enforced private-IP egress guard.
RESEARCH_ALLOWED_DOMAINS=
RESEARCH_TERMS_APPROVED=false
RESEARCH_NETWORK_GUARD_APPROVED=false
# Stripe TEST mode only; live-mode credentials/events are rejected.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_SEND_ENABLED=false
